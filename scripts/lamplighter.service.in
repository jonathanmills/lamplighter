[Unit]
Description=Lamplighter policy engine
Documentation=man:lamplighter(1)
# only works if there is a single configuration file in @CONFDIR@/lamplighter.d

[Service]
Type=simple
KillMode=mixed
EnvironmentFile=-@CONFDIR@/sysconfig/lamplighter
LimitNOFILE=8096
ExecStart=@SBINDIR@/lamplighter $LAMPLIGHTER_OPT
ExecReload=/bin/kill -HUP $MAINPID
