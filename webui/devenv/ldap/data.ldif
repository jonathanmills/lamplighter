#
# Test directory (RFC 2307bis layout): users are inetOrgPerson +
# posixAccount and get memberOf from the overlay; groups are
# groupOfNames (+ posixGroup for Unix project groups).
#
# All passwords are TEST-ONLY values for this throwaway directory.
# User password for every person: "password".
#
# This file is also the single source of truth for the test data
# generator (testdata/accounts.py and testdata/generate.py), so keep
# one attribute per line and no LDIF line folding.

dn: dc=lamplighter,dc=test
objectClass: dcObject
objectClass: organization
dc: lamplighter
o: Lamplighter Dev

dn: ou=people,dc=lamplighter,dc=test
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=lamplighter,dc=test
objectClass: organizationalUnit
ou: groups

dn: ou=services,dc=lamplighter,dc=test
objectClass: organizationalUnit
ou: services

# --- service accounts (bind DNs for the web UI and Keycloak) ---

dn: cn=lamplighter-webui,ou=services,dc=lamplighter,dc=test
objectClass: applicationProcess
objectClass: simpleSecurityObject
cn: lamplighter-webui
userPassword: webui-bind-secret

dn: cn=lamplighter-keycloak,ou=services,dc=lamplighter,dc=test
objectClass: applicationProcess
objectClass: simpleSecurityObject
cn: lamplighter-keycloak
userPassword: keycloak-bind-secret

