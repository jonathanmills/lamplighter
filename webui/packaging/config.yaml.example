#
# Lamplighter web UI configuration: /etc/lux-webui/config.yaml
#
# Secrets never go in this file. Each one lives in its own file, readable
# only by root and the lux-webui group (chmod 0640, chgrp lux-webui), e.g.
#   install -m 0640 -g lux-webui /dev/null /etc/lux-webui/ldap-bind.secret
# Replace every example.org value below.

server:
  base_url: https://robinhood.example.org          # the URL people type; must match nginx
  session_secret_file: /etc/lux-webui/session.secret   # long random string: openssl rand -hex 32
  session_ttl_seconds: 28800
  frontend_dir: /usr/share/lux-webui/frontend      # installed by the RPM

# Single sign-on through Keycloak (OpenID Connect).
oidc:
  enabled: true
  issuer: https://keycloak.example.org/realms/REALM
  client_id: lux-webui
  client_secret_file: /etc/lux-webui/oidc-client.secret
  # ca_file: /etc/pki/tls/certs/site-ca.pem       # unset = system trust store
  username_claim: preferred_username              # must equal the LDAP uid

# Users, groups and roles come from LDAP whatever the login method.
ldap:
  servers: [ldaps://ldap1.example.org, ldaps://ldap2.example.org]
  # ca_file: /etc/pki/tls/certs/site-ca.pem
  bind_dn: cn=lux-webui,ou=services,dc=example,dc=org
  bind_password_file: /etc/lux-webui/ldap-bind.secret
  directory_type: rfc2307bis                      # or rfc2307, active_directory
  users:
    base_dn: ou=people,dc=example,dc=org
  groups:
    base_dn: ou=groups,dc=example,dc=org
    membership: memberof                          # or member_search

login:
  ldap_bind_enabled: false                        # direct directory-password login form

access:
  # Members of these groups are admins: needed for the first sign-in.
  bootstrap_admin_groups:
    - cn=lux-admins,ou=groups,dc=example,dc=org
  role_mappings:
    - group: cn=lux-data-managers,ou=groups,dc=example,dc=org
      roles: [data-manager]
    - group: cn=lux-viewers,ou=groups,dc=example,dc=org
      roles: [viewer]

# Robinhood's own database: read only. Ideally a replica.
# Grants: SELECT and CREATE TEMPORARY TABLES on the robinhood schema.
database:
  host: db-replica.example.org
  name: robinhood_lustre
  user: lux_webui
  password_file: /etc/lux-webui/db.secret

# The web UI's own schema (collector results, audit copy): read-write.
# Grants: ALL on lux_webui.*
store:
  host: db.example.org
  name: lux_webui
  user: lux_webui
  password_file: /etc/lux-webui/store.secret

collector:
  keep_runs: 90
  max_scan_seconds: 21600
  rollup_depth: 4
  audit_retention_days: 400

# Lustre jobstats for the triage view (optional; without this section,
# triage shows Robinhood's side only). No job scheduler is needed.
#
# Default source: a spool directory. On each Lustre server (MDS and OSS),
# a cron job writes a snapshot every minute, for example in
# /etc/cron.d/lux-jobstats:
#
#   * * * * * root f=/path/to/spool/$(hostname -s).$(date +\%s).jobstats; lctl get_param 'mdt.*.job_stats' 'obdfilter.*.job_stats' > $f.tmp 2>/dev/null && mv $f.tmp $f
#
# The files must end up in spool.directory on this host, by any transport
# (an NFS export, rsync or scp as an account in the lux-jobstats group).
# Write them as *.tmp and rename, so half-written files are never read.
#
#jobstats:
#  source: spool                 # or: prometheus (if the site already runs it)
#  spool:
#    directory: /var/spool/lux-jobstats
#  retention_hours: 168
#  stale_after_seconds: 300
#  # Lustre's jobid_name: the default "%e.%u" gives process name and UID.
#  jobid_pattern: '^(?P<process>.+)\.(?P<uid>\d+)$'
#  prometheus:                   # only with source: prometheus
#    url: https://prometheus.example.org:9090
#    metrics:                    # counter names of your Lustre exporter
#      md_ops: lustre_job_md_ops_total
#      read_bytes: lustre_job_read_bytes_total
#      write_bytes: lustre_job_write_bytes_total

# Checkmk polls /api/v1/monitoring with a Keycloak client-credentials token.
monitoring:
  enabled: true
  audience: lux-webui
  required_role: monitoring
