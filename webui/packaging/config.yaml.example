#
# Lamplighter web UI configuration: /etc/lamplighter.d/webui/config.yaml
#
# Secrets never go in this file. Each one lives in its own file, readable
# only by root and the lamplighter-webui group (chmod 0640, chgrp lamplighter-webui), e.g.
#   install -m 0640 -g lamplighter-webui /dev/null /etc/lamplighter.d/webui/ldap-bind.secret
# Replace every example.org value below.

server:
  base_url: https://robinhood.example.org          # the URL people type; must match nginx
  session_secret_file: /etc/lamplighter.d/webui/session.secret   # long random string: openssl rand -hex 32
  session_ttl_seconds: 28800
  frontend_dir: /usr/share/lamplighter-webui/frontend      # installed by the RPM

# Single sign-on through Keycloak (OpenID Connect).
oidc:
  enabled: true
  issuer: https://keycloak.example.org/realms/REALM
  client_id: lamplighter-webui
  client_secret_file: /etc/lamplighter.d/webui/oidc-client.secret
  # ca_file: /etc/pki/tls/certs/site-ca.pem       # unset = system trust store
  username_claim: preferred_username              # must equal the LDAP uid

# Users, groups and roles come from LDAP whatever the login method.
ldap:
  servers: [ldaps://ldap1.example.org, ldaps://ldap2.example.org]
  # ca_file: /etc/pki/tls/certs/site-ca.pem
  bind_dn: cn=lamplighter-webui,ou=services,dc=example,dc=org
  bind_password_file: /etc/lamplighter.d/webui/ldap-bind.secret
  directory_type: rfc2307bis                      # or rfc2307, active_directory
  users:
    base_dn: ou=people,dc=example,dc=org
  groups:
    base_dn: ou=groups,dc=example,dc=org
    membership: memberof                          # or member_search

login:
  ldap_bind_enabled: false                        # direct directory-password login form

access:
  # Members of these groups are admins: needed for the first sign-in.
  bootstrap_admin_groups:
    - cn=lamplighter-admins,ou=groups,dc=example,dc=org
  role_mappings:
    - group: cn=lamplighter-data-managers,ou=groups,dc=example,dc=org
      roles: [data-manager]
    - group: cn=lamplighter-viewers,ou=groups,dc=example,dc=org
      roles: [viewer]

# Robinhood's own database: read only. Ideally a replica.
# Grants: SELECT and CREATE TEMPORARY TABLES on the robinhood schema.
# On a replica, optional indexes make whole-filesystem search by owner,
# group or size, and the collector's directory rollup, much faster (run on
# the replica as a MariaDB administrator; hours on billions of entries):
#   lamplighter-config replica_indexes create <robinhood db>
database:
  host: db-replica.example.org
  name: robinhood_lustre
  user: lamplighter_webui
  password_file: /etc/lamplighter.d/webui/db.secret

# The web UI's own schema (collector results, audit copy): read-write.
# Grants: ALL on lamplighter_webui.*
store:
  host: db.example.org
  name: lamplighter_webui
  user: lamplighter_webui
  password_file: /etc/lamplighter.d/webui/store.secret

collector:
  keep_runs: 90
  max_scan_seconds: 21600
  rollup_depth: 4
  audit_retention_days: 400
  # Parallel connections for the plain scans of Robinhood's ENTRIES table
  # (about as many as the database server has cores to spare), and memory
  # per query for in-memory grouping (MariaDB tmp_table_size).
  workers: 4
  work_mem: 2147483648
  # Optional: a writable schema on the same MariaDB server as `database`
  # (a single instance, or the replica Lamplighter reads), so the directory
  # rollup runs on `workers` connections too. Unset, the rollup uses one
  # connection and TEMPORARY tables. Grant the database user above full
  # rights on this schema only; it needs just SELECT on Robinhood's:
  #   CREATE DATABASE lamplighter_scratch;
  #   GRANT ALL PRIVILEGES ON lamplighter_scratch.* TO 'robinhood'@'<webui host>';
  # Speeds up most with the replica indexes (below: `database`).
  # scratch_schema: lamplighter_scratch

# Lustre jobstats for the triage view (optional; without this section,
# triage shows Robinhood's side only). No job scheduler is needed.
#
# Default source: a spool directory. On each Lustre server (MDS and OSS),
# a cron job writes a snapshot every minute, for example in
# /etc/cron.d/lamplighter-jobstats:
#
#   * * * * * root f=/path/to/spool/$(hostname -s).$(date +\%s).jobstats; lctl get_param 'mdt.*.job_stats' 'obdfilter.*.job_stats' > $f.tmp 2>/dev/null && mv $f.tmp $f
#
# The files must end up in spool.directory on this host, by any transport
# (an NFS export, rsync or scp as an account in the lamplighter-jobstats group).
# Write them as *.tmp and rename, so half-written files are never read.
#
#jobstats:
#  source: spool                 # or: prometheus (if the site already runs it)
#  spool:
#    directory: /var/spool/lamplighter-jobstats
#  retention_hours: 168          # hourly summaries; minute detail is kept 25 hours
#  stale_after_seconds: 300
#  # Lustre's jobid_name: the default "%e.%u" gives process name and UID.
#  jobid_pattern: '^(?P<process>.+)\.(?P<uid>\d+)$'
#  prometheus:                   # only with source: prometheus
#    url: https://prometheus.example.org:9090
#    metrics:                    # counter names of your Lustre exporter
#      md_ops: lustre_job_md_ops_total
#      read_bytes: lustre_job_read_bytes_total
#      write_bytes: lustre_job_write_bytes_total

# Checkmk polls /api/v1/monitoring with a Keycloak client-credentials token.
monitoring:
  enabled: true
  audience: lamplighter-webui
  required_role: monitoring
