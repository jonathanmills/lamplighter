[Unit]
Description=Lamplighter web UI collector (age histogram, usage history, directory totals)
Documentation=file:///usr/share/doc/lamplighter-webui/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lamplighter-webui
Group=lamplighter-webui
Environment=LAMPLIGHTER_WEBUI_CONFIG=/etc/lamplighter.d/webui/config.yaml
ExecStart=/opt/lamplighter-webui/bin/lamplighter-collector run
# One full scan of Robinhood's ENTRIES table: keep it gentle.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=8h

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
