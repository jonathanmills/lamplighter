[Unit]
Description=Lamplighter web UI
Documentation=file:///usr/share/doc/lamplighter-webui/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=lamplighter-webui
Group=lamplighter-webui
Environment=LAMPLIGHTER_WEBUI_CONFIG=/etc/lamplighter.d/webui/config.yaml
# Listens on localhost only; nginx terminates TLS in front of it.
# One worker: login sessions are kept in memory (see the README).
ExecStart=/opt/lamplighter-webui/bin/uvicorn lamplighter_webui.app:create_app --factory \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=5

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
